# LinkedIn session cookie (li_at) from your own logged-in browser session.
# Get it from: DevTools > Application (or Storage) > Cookies > https://www.linkedin.com > li_at
# This is the same kind of credential PhantomBuster's "sessionCookie" field used.
# NEVER commit your real .env file - it's gitignored.
LINKEDIN_LI_AT_COOKIE=

# Optional - override the default Chrome user agent string.
LINKEDIN_USER_AGENT=

# Path to a Google service account JSON key file with Sheets API access.
# Share your Google Sheet (Editor access) with that service account's email
# address (looks like xxx@xxx.iam.gserviceaccount.com) or writes will fail.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

SPREADSHEET_ID=
COMPANIES_SHEET_NAME=Companies
PROSPECTS_SHEET_NAME=Prospects

# Sales Navigator keyword filter applied alongside the per-company filter.
# Boolean OR syntax, matches Sales Navigator's own search keyword box.
TITLE_KEYWORDS=CIO OR "Chief Information Officer" OR "IT Head" OR "Head of IT" OR "IT Director" OR "VP IT" OR COO OR "Head of Procurement" OR "Procurement Director" OR "IT Manager"

MAX_PROSPECTS_PER_COMPANY=25

# Pacing between actions (ms) - keeps requests at a reasonable, non-abusive rate.
MIN_DELAY_MS=2000
MAX_DELAY_MS=5000

# false = show the browser window - useful for tuning selectors on first run.
HEADLESS=true

# true = save a full-page screenshot per company search, for selector debugging.
DEBUG_SCRAPER=false
