# LinkedIn session cookie (li_at) from your own logged-in browser session.
# Get it from: DevTools > Application (or Storage) > Cookies > https://www.linkedin.com > li_at
# This is the same kind of credential PhantomBuster's "sessionCookie" field used.
# NEVER commit your real .env file - it's gitignored.
LINKEDIN_LI_AT_COOKIE=

# Optional - override the default Chrome user agent string.
LINKEDIN_USER_AGENT=

# Google service account with Sheets API access - two ways to provide it,
# pick one. Share your Google Sheet (Editor access) with the service
# account's email (xxx@xxx.iam.gserviceaccount.com) either way, or writes fail.

# Local dev: path to the downloaded JSON key file.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Render deploy (no persistent disk for a file): paste the whole key file's
# JSON content as one line instead, and leave GOOGLE_SERVICE_ACCOUNT_KEY_PATH
# unset. Example: GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

SPREADSHEET_ID=
COMPANIES_SHEET_NAME=Companies
PROSPECTS_SHEET_NAME=Prospects

MAX_PROSPECTS_PER_COMPANY=25

# Pacing between actions (ms) - keeps requests at a reasonable, non-abusive rate.
MIN_DELAY_MS=2000
MAX_DELAY_MS=5000

# false = show the browser window - useful for tuning selectors on first run.
HEADLESS=true

# true = save a full-page screenshot per company search, for selector debugging.
DEBUG_SCRAPER=false

# How long a single page navigation can take before it's treated as failed
# (ms). Prevents a stuck page from hanging the process/leaking memory.
NAVIGATION_TIMEOUT_MS=30000

# Retries per company on a transient failure (navigation timeout etc.) before
# marking it Error. A checkpoint/session-expired failure is never retried,
# regardless of this value, since retrying against a dead session can't help.
MAX_RETRIES_PER_COMPANY=1

# Optional - appends one summary row per run to this sheet tab (create it
# with headers: StartedAt, FinishedAt, CompaniesProcessed, TotalProspects,
# FatalError, ErrorCompanies). Leave blank to skip run-history logging.
RUN_LOG_SHEET_NAME=RunLog

# Only used when running as a server (src/server.js, e.g. on Render) - not
# used by the local CLI (src/index.js). Required to protect the public
# /run and /status endpoints; without it they're open to anyone with the URL.
RUN_TOKEN=

# Render sets this automatically - only needed locally if you run the server
# yourself (npm run server) and want a specific port.
PORT=3000

# Caps how many companies one /run call processes, bounding memory/duration
# on a constrained host - ping /run more often to work through a backlog
# instead of raising this. 0 or unset = no limit (only safe off Render).
COMPANIES_PER_RUN=1

# Rejects a /run call (429) that arrives less than this many ms after the
# previous run finished - guards against a misconfigured/duplicate external
# pinger causing overlapping or back-to-back LinkedIn sessions.
MIN_RUN_INTERVAL_MS=300000

# --- OpenAI qualification (Sharp SSDI rubric, same prompt as the n8n flow) ---
# Optional. With a key set, every scraped decision maker is scored 1-100 and
# only the top TOP_N_PER_COMPANY are written (score >= AUTO_APPROVE_SCORE ->
# Status "Auto-Approved", else "Needs Review"). Without a key, all scraped
# decision makers are written unscored as "Needs Review".
# Key from platform.openai.com (a ChatGPT subscription does NOT include this).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TOP_N_PER_COMPANY=4
AUTO_APPROVE_SCORE=70
